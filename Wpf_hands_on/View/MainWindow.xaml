<Window x:Class="Wpf_hands_on.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_hands_on"
        mc:Ignorable="d"
        Title="MainWindow" WindowState="Maximized">
    <Grid>
        <DockPanel>
            <TextBlock x:Name="abc" DockPanel.Dock="Top" Padding="40" Background="Blue" FontSize="20" FontWeight="Medium" Foreground="white">Soliton Employee Portal</TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="30">
                    <TextBlock FontSize="15" Foreground="DarkBlue" FontWeight="SemiBold" LineHeight="30" TextAlignment="Justify">
                        Welcome! we you help to <LineBreak/>
                        <Span FontSize="25" FontWeight="Bold">Add, Delete and View</Span> employee details
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Width" Value="150" />
                                <Setter Property="Padding" Value="0 5" />
                                <Setter Property="Margin" Value="5" />
                                <Setter Property="Background" Value="DarkBlue" />
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </StackPanel.Resources>
                        <Button>Add</Button>
                        <Button>Delete</Button>
                    </StackPanel>
                    <Border>
                        <DataGrid x:Name="EmployeeListGrid" AutoGenerateColumns="False" Background="AliceBlue" SelectionChanged="EmployeeListGrid_SelectionChanged">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns >
                                <DataGridTextColumn Width="*" Header="Name" Binding="{Binding Name}" IsReadOnly="True"/>
                                <DataGridTextColumn Width="*" Header="Job Title" Binding="{Binding JobTitle}" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" Header="Email" Binding="{Binding MailId}" IsReadOnly="True" />
                                <DataGridTextColumn Width="*" Header="Phone" Binding="{Binding PhoneNumber}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" x:Name="EmployeeDetails" Background="AliceBlue">

                    <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="30">Employee Details</TextBlock>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="150"/>
                        <Grid Grid.Column="1">
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="LineHeight" Value="40"/>
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock>Name</TextBlock>
                            <TextBlock Grid.Column="1" x:Name="EmpName">Name</TextBlock>
                            <TextBlock Grid.Row="1">Job Title</TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EmpJobTitle">Name</TextBlock>
                            <TextBlock Grid.Row="2">Email</TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EmpEmail">Name</TextBlock>
                            <TextBlock Grid.Row="3">Phone</TextBlock>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EmpPhone">Name</TextBlock>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
