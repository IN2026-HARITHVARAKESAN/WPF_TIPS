<Window x:Class="Wpf_hands_on.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" SizeToContent="Height" Width="250">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="10,10"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2">
                <Image Source="https://www.wikipedia.org/portal/wikipedia.org/assets/img/Wikipedia-logo-v2@1.5x.png" Height="44" Width="48"/>
                <TextBlock Text="Wikipedia" FontWeight="ExtraBold" FontSize="25" Margin="10,0" VerticalAlignment="Center"/>
            </StackPanel>
            
            <Label Grid.Row="1" Content="_Name :" Target="{Binding ElementName=txtName}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="txtName" AcceptsReturn="True" TextWrapping="Wrap" SpellCheck.IsEnabled="True"/>
            
            <Label Grid.Row="2" Content="Selection _text:" Target="{Binding ElementName=txtInput}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="txtInput" SelectionChanged="TextBox_SelectionChanged"/>
            <TextBox Grid.Row="3" Grid.ColumnSpan="2" Name="txtSelection" Text="Default Text" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"/>

            <StackPanel Margin="0,10" Grid.Row="4" Grid.ColumnSpan="2">
                <Label Content="Select Known _Stacks" Target="{Binding ElementName=cbAllStack}"/>
                <CheckBox IsThreeState="True" Name="cbAllStack" Checked="cbAllStack_Checked" Unchecked="cbAllStack_Checked">All Stack</CheckBox>
                <StackPanel Margin="10,5">
                    <CheckBox Name="cStack" Content="C#" Checked="cbStack_Changed" Unchecked="cbStack_Changed"/>
                    <CheckBox Name="pythonStack" Content="Python" Checked="cbStack_Changed" Unchecked="cbStack_Changed"/>
                    <CheckBox Name="labviewStack" Content="Labview" Checked="cbStack_Changed" Unchecked="cbStack_Changed"/>
                </StackPanel>
            </StackPanel>

            <Label Content="Gender :" Grid.Row="5"/>
            <RadioButton Grid.Row="6" HorizontalAlignment="Center">Male</RadioButton>
            <RadioButton Grid.Row="6" Grid.Column="1" HorizontalAlignment="Center">Female</RadioButton>
            
            <Button Grid.Row="7" Grid.ColumnSpan="2" Name="submitBtn" Content="Submit" Click="submitBtn_Click"/>
        </Grid>
    </ScrollViewer>
</Window>
