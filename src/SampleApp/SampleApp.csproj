<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.DebuggerVisualizers" Version="17.6.1032901" />
    <PackageReference Include="System.Text.Json" Version="10.0.2" />
  </ItemGroup>

	<ItemGroup>
		<Reference Include="DataVisualizer.dll">
			<HintPath>C:\Users\Harithvarakesan.bs\Documents\Visual Studio 2022\Visualizers\DataVisualizer.dll</HintPath>
		</Reference>
	</ItemGroup>




	<!-- Copy Microsoft.VisualStudio.DebuggerVisualizers.dll from Visual Studio installation -->
  <Target Name="CopyDebuggerVisualizerDll" AfterTargets="Build">
    <PropertyGroup>
      <VSInstallDir>C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\PublicAssemblies</VSInstallDir>
      <DebuggerVisualizerDll>$(VSInstallDir)\Microsoft.VisualStudio.DebuggerVisualizers.dll</DebuggerVisualizerDll>
    </PropertyGroup>
    <Copy Condition="Exists('$(DebuggerVisualizerDll)')" SourceFiles="$(DebuggerVisualizerDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Message Condition="!Exists('$(DebuggerVisualizerDll)')" Text="Warning: Could not find Microsoft.VisualStudio.DebuggerVisualizers.dll at $(DebuggerVisualizerDll)" Importance="high" />
  </Target>

</Project>