    <SolidColorBrush x:Key="PrimaryGreen" Color="#67C090"/>
    <SolidColorBrush x:Key="TitleBarText" Color="#0F0E0E"/>
    <SolidColorBrush x:Key="DarkBlue" Color="#124170"/>
    <SolidColorBrush x:Key="Red" Color="#E43636"/>
