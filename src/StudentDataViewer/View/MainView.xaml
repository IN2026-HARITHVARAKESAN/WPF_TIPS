<Window x:Class="StudentDataViewer.MainView"
        xmlns:res ="clr-namespace:StudentDataViewer.Resources"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentDataViewer"
        xmlns:views="clr-namespace:StudentDataViewer.Views"
        mc:Ignorable="d"
        Title="Student Data Viewer" Height="500" Width="1100" WindowStyle="None"
        AllowsTransparency="False" Background="{StaticResource StandardWhite}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Border BorderBrush="{StaticResource StandardGray}" BorderThickness="1">
        <Grid>
            <DockPanel VerticalAlignment="Top" Background="{StaticResource PrimaryGreen}" Height="40" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Image Source="pack://application:,,,/Resources/Images/logo.png" HorizontalAlignment="Left" Height="28" Margin="10,6,5,6"/>
                <TextBlock Text="{x:Static res:Strings.TitleText}"  VerticalAlignment="Center" FontFamily="Cascadia Mono" Foreground="{StaticResource TitleBarText}"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="0,0,10,0"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="MinimizeButton" AutomationProperties.AutomationId="MinimizeButton" Width="25" Height="25" Style="{StaticResource WindowControlButtonStyle}" Content="&#x2015;" FontSize="16" ToolTip="Minimize" Cursor="Hand" Click="MinimizeButton_Click"/>
                    <Button x:Name="CloseButton" AutomationProperties.AutomationId="CloseButton" Width="25" Height="25" Content="&#x2715;" Style="{StaticResource WindowControlButtonStyle}" FontSize="16" ToolTip="Close" Cursor="Hand" Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <views:LeftPanelUserControl Grid.Column="0"/>
                
            </Grid>
        </Grid>
    </Border>
</Window>