<UserControl x:Class="StudentDataViewer.Views.LeftPanelUserControl"
             xmlns:res ="clr-namespace:StudentDataViewer.Resources"
             x:Name="RootControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudentDataViewer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Grid.Column="0" Margin="10,75,20,30" BorderBrush="{StaticResource StandardGray}" BorderThickness="0,0,1,0" CornerRadius="0" Background="{StaticResource StandardWhite}" Opacity="50">
            <StackPanel Orientation="Vertical" Grid.Column="0" Margin="0,0,0,-31">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.TitleStudentDataList}" FontFamily="Cascadia Mono" FontSize="16" Margin="10,5"/>
                    <ComboBox Width="60" Height="25" IsEditable="False" Margin="10,0,0,0" ItemsSource="{Binding SectionsWithAll}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"/>

                </StackPanel>
                <DataGrid x:Name="StudentDataGrid" ItemsSource="{Binding StudentsToDisplay}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" GridLinesVisibility="All" RowHeaderWidth="0"
                          Background="{StaticResource StandardWhite}" BorderThickness="0" Margin="12,0" Height="300" Width="auto"
                          RowBackground="{StaticResource StandardWhite}" Padding="0" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HorizontalGridLinesBrush="{StaticResource StandardBlack}" VerticalGridLinesBrush="{StaticResource StandardBlack}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E8F6E8"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource StandardWhite}"/>
                            <Setter Property="Foreground" Value="{StaticResource StandardBlack}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0,1,1,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource StandardBlack}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                        </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E8F6E8"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Trigger>
                            </Style.Triggers>

                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="30">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="SelectAllCheckBox" Checked="SelectAllCheckBox_Checked" Unchecked="SelectAllCheckBox_Unchecked"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay,  UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static res:Strings.TitleStudentId}" IsReadOnly="True" Width="70" Binding="{Binding StudentId}"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.TitleName}" IsReadOnly="True" Width="120" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.TitleDepartment}" IsReadOnly="True" Width="100" Binding="{Binding Department}"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.TitleSection}" IsReadOnly="True" Width="*" Binding="{Binding Section}"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.TitleYear}" IsReadOnly="True" Width="*" Binding="{Binding Year}"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.TitleCGPA}" IsReadOnly="True" Width="*" Binding="{Binding Cgpa}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,40,0">
                    <Button x:Name="AddNewStudentButton" Width="130" Height="30" Background="Transparent" Foreground="{StaticResource StandardWhite}" ToolTip="Add new student" BorderThickness="0" Padding="0" Click="AddNewStudentButton_Click">
                        <Border Background="{StaticResource DarkBlue}" CornerRadius="10" BorderThickness="2" Padding="10,5">
                            <TextBlock Text="{x:Static res:Strings.ButtonAddNewStudent}" Foreground="{StaticResource StandardWhite}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Button x:Name="EditStudentButton" Width="129" Height="30" Background="Transparent" Foreground="{StaticResource StandardWhite}" ToolTip="Add new student" BorderThickness="0" Padding="0" Click="EditStudentButton_Click">
                        <Border Background="{StaticResource PrimaryGreen}" CornerRadius="10" BorderThickness="2" Padding="10,5">
                            <TextBlock Text="{x:Static res:Strings.ButtonEditStudent}" Foreground="{StaticResource StandardWhite}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Button x:Name="DeleteStudentButton" Width="130" Height="30" Background="Transparent" Foreground="{StaticResource StandardWhite}" ToolTip="Add new student" BorderThickness="0" Padding="0" Click="DeleteStudentButton_Click">
                        <Border Background="{StaticResource Red}" CornerRadius="10" BorderThickness="2" Padding="10,5" Width="87">
                            <TextBlock Text="{x:Static res:Strings.ButtonDeleteStudent}" Foreground="{StaticResource StandardWhite}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>