<Window x:Class="StandaloneVisualizer.VisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Visualizer" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" 
                           Text="Data Visualizer" 
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="Bold"/>
                <TextBlock x:Name="SubtitleTextBlock"
                           Foreground="#ECF0F1"
                           FontSize="12"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" 
                  x:Name="DataGrid"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  GridLinesVisibility="All"
                  AlternatingRowBackground="#F5F5F5"
                  HeadersVisibility="All"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  Margin="10"
                  FontSize="13">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="BorderBrush" Value="#2C3E50"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="BorderBrush" Value="#BDC3C7"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3498DB"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#ECF0F1" Padding="5">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status: " FontWeight="Bold"/>
                    <TextBlock x:Name="StatusText" Text="Ready"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Margin="10,0"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Rows: " FontWeight="Bold"/>
                    <TextBlock x:Name="RowCountText" Text="0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Margin="10,0"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Columns: " FontWeight="Bold"/>
                    <TextBlock x:Name="ColumnCountText" Text="0"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="Export to CSV" 
                        x:Name="ExportButton"
                        Click="ExportButton_Click"
                        Padding="10,3"
                        Background="#27AE60"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
